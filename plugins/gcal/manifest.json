{
  "id": "gcal",
  "name": "Google カレンダー記録",
  "category": "connect",
  "tags": [
    "Googleカレンダー"
  ],
  "version": "1.0.0",
  "tier": "advanced",
  "manifestVersion": 2,
  "runtime": "inproc",
  "main": "index.js",
  "kind": "integration",
  "provides": [
    "session.recorder@1",
    "ui.panel@1"
  ],
  "subscribes": [
    "session.*"
  ],
  "secrets": [
    "google.oauth"
  ],
  "api": {
    "namespaces": [
      "calendar"
    ]
  },
  "timeouts": {
    "onEvent": 15000
  },
  "configSchema": "config.schema.json",
  "defaultMode": "legacy",
  "requires": [
    "session.controller@1"
  ],
  "actions": {
    "getStatus": "read",
    "flushQueue": "write"
  },
  "panels": [
    {
      "name": "status",
      "title": "Google カレンダー",
      "file": "ui/panel.html"
    }
  ],
  "coreApi": 2,
  "needs": [
    "secrets",
    "storage",
    "api.register"
  ]
}
