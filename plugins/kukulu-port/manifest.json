{
  "id": "kukulu-port",
  "audience": "public",
  "stability": "stable",
  "name": "kukulu の枠",
  "category": "tool",
  "version": "0.1.0",
  "tier": "standard",
  "manifestVersion": 2,
  "runtime": "inproc",
  "main": "index.js",
  "kind": "integration",
  "provides": [
    "stream.lifecycle@1",
    "ui.panel@1"
  ],
  "subscribes": [
    "stream.starting",
    "stream.started",
    "stream.metadata.changed",
    "stream.stopped",
    "session.retitled"
  ],
  "secrets": [
    "kukulu.config"
  ],
  "timeouts": {
    "onEvent": 20000,
    "onObsEvent": 20000
  },
  "configSchema": "config.schema.json",
  "defaultMode": "legacy",
  "actions": {
    "getStatus": "read"
  },
  "panels": [
    {
      "name": "status",
      "title": "kukulu の枠",
      "file": "ui/panel.html"
    }
  ],
  "coreApi": 2,
  "needs": [
    "secrets",
    "sessions",
    "storage"
  ]
}
