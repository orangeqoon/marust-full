{
  "id": "hotkeys",
  "name": "ホットキー",
  "category": "tool",
  "tags": [
    "ホットキー",
    "キー"
  ],
  "version": "1.1.0",
  "tier": "standard",
  "manifestVersion": 2,
  "runtime": "inproc",
