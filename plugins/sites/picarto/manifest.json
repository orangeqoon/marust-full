{
  "id": "picarto",
  "name": "Picarto",
  "category": "destination",
  "version": "0.1.0",
  "tier": "standard",
  "manifestVersion": 2,
  "runtime": "inproc",
  "secrets": [
    "picarto.config"
  ],
  "roles": {
    "site": {
      "main": "site.js",
      "provides": [
        "stream.site@1",
        "ui.panel@1"
      ],
      "secrets": [
        "picarto.config"
      ],
      "defaultMode": "legacy",
      "actions": {
        "getStatus": "read"
      },
      "panels": [
        {
          "name": "status",
          "title": "Picarto",
          "file": "ui/panel.html"
        }
      ],
      "needs": [
        "secrets"
      ]
    },
    "sink": {
      "name": "Picarto送信",
      "main": "sink.js",
      "provides": [
        "chat.sink@1"
      ],
      "secrets": [
        "picarto.config"
      ],
      "defaultMode": "legacy",
      "actions": {
        "getStatus": "read"
      },
      "needs": [
        "secrets"
      ]
    }
  },
  "audience": "public",
  "stability": "experimental",
  "site": {
    "id": "picarto",
    "name": "Picarto",
    "order": 8,
    "tier": "extra",
    "ingest": [
      {
        "label": "自動（いちばん近いサーバー。おすすめ）",
        "url": "rtmp://live.us.picarto.tv/golive",
        "helpUrl": "https://github.com/obsproject/obs-studio/blob/master/plugins/rtmp-services/data/services.json"
      },
      {
        "label": "ロサンゼルス",
        "url": "rtmp://live.us-losangeles.picarto.tv/golive",
        "helpUrl": "https://github.com/obsproject/obs-studio/blob/master/plugins/rtmp-services/data/services.json"
      },
      {
        "label": "ダラス",
        "url": "rtmp://live.us-dallas.picarto.tv/golive",
        "helpUrl": "https://github.com/obsproject/obs-studio/blob/master/plugins/rtmp-services/data/services.json"
      },
      {
        "label": "マイアミ",
        "url": "rtmp://live.us-miami.picarto.tv/golive",
        "helpUrl": "https://github.com/obsproject/obs-studio/blob/master/plugins/rtmp-services/data/services.json"
      },
      {
        "label": "ニューヨーク",
        "url": "rtmp://live.us-newyork.picarto.tv/golive",
        "helpUrl": "https://github.com/obsproject/obs-studio/blob/master/plugins/rtmp-services/data/services.json"
      },
      {
        "label": "ヨーロッパ",
        "url": "rtmp://live.eu-west1.picarto.tv/golive",
        "helpUrl": "https://github.com/obsproject/obs-studio/blob/master/plugins/rtmp-services/data/services.json"
      }
    ],
    "keyHelpUrl": null,
    "addHint": "サーバーは OBS の一覧と同じものです。ストリームキーは Picarto の配信の設定の画面で確かめて、下の欄に貼ってください。",
    "tosUrl": null,
    "login": {
      "type": "config",
      "needed": "optional",
      "for": [
        "題名"
      ]
    },
    "configSchema": [
      {
        "name": "token",
        "label": "トークン",
        "secret": true,
        "required": true
      },
      {
        "name": "channel",
        "label": "チャンネル名",
        "secret": false,
        "required": true
      }
    ],
    "apiHosts": [
      "api.picarto.tv"
    ]
  },
  "coreApi": 2
}
