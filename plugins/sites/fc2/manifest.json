{
  "id": "fc2",
  "name": "FC2",
  "category": "destination",
  "version": "0.1.0",
  "tier": "standard",
  "manifestVersion": 2,
  "runtime": "inproc",
  "secrets": [
    "cookies.fc2-main",
    "fc2.config",
    "capture.fc2-main.page",
    "capture.fc2-main.fc2-http"
  ],
  "roles": {
    "site": {
      "main": "site.js",
      "provides": [
        "stream.site@1",
        "ui.panel@1"
      ],
      "subscribes": [
        "auth.updated"
      ],
      "secrets": [
        "cookies.fc2-main",
        "fc2.config",
        "capture.fc2-main.page",
        "capture.fc2-main.fc2-http"
      ],
      "timeouts": {
        "updateTitle": 20000,
        "updateMetadata": 20000
      },
      "defaultMode": "legacy",
      "actions": {
        "getStatus": "read"
      },
      "panels": [
        {
          "name": "status",
          "title": "FC2",
          "file": "ui/panel.html"
        }
      ],
      "needs": [
        "secrets"
      ]
    },
    "sink": {
      "name": "FC2送信",
      "main": "sink.js",
      "provides": [
        "chat.sink@1"
      ],
      "secrets": [
        "cookies.fc2-main",
        "fc2.config",
        "capture.fc2-main.page",
        "capture.fc2-main.fc2-http"
      ],
      "defaultMode": "legacy",
      "actions": {
        "getStatus": "read"
      },
      "needs": [
        "secrets"
      ]
    }
  },
  "audience": "public",
  "stability": "experimental",
  "site": {
    "id": "fc2",
    "name": "FC2ライブ",
    "order": 6,
    "tier": "extra",
    "ingest": [],
    "keyHelpUrl": null,
    "addHint": "このサイトのサーバーの URL とキーは、サイトの配信の設定の画面で確かめて、下の欄に貼ってください。",
    "tosUrl": null,
    "login": {
      "type": "cookie",
      "needed": "optional",
      "for": [
        "題名"
      ]
    },
    "apiHosts": [
      "live.fc2.com"
    ]
  },
  "coreApi": 2
}
