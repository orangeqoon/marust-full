{
  "id": "twitcasting",
  "name": "ツイキャス",
  "category": "destination",
  "version": "0.1.0",
  "tier": "standard",
  "manifestVersion": 2,
  "runtime": "inproc",
  "secrets": [
    "cookies.twitcasting-main",
    "twitcasting.config",
    "capture.twitcasting-main.page"
  ],
  "roles": {
    "site": {
      "main": "site.js",
      "provides": [
        "stream.site@1",
        "ui.panel@1"
      ],
      "subscribes": [
        "auth.updated"
      ],
      "secrets": [
        "cookies.twitcasting-main",
        "twitcasting.config",
        "capture.twitcasting-main.page"
      ],
      "timeouts": {
        "updateTitle": 20000,
        "updateMetadata": 20000
      },
      "defaultMode": "legacy",
      "actions": {
        "getStatus": "read"
      },
      "panels": [
        {
          "name": "status",
          "title": "ツイキャス",
          "file": "ui/panel.html"
        }
      ],
      "needs": [
        "secrets"
      ]
    },
    "sink": {
      "name": "ツイキャス送信",
      "main": "sink.js",
      "provides": [
        "chat.sink@1"
      ],
      "secrets": [
        "twitcasting.config"
      ],
      "defaultMode": "legacy",
      "actions": {
        "getStatus": "read"
      },
      "needs": [
        "secrets"
      ]
    }
  },
  "audience": "public",
  "stability": "experimental",
  "site": {
    "id": "twitcasting",
    "name": "ツイキャス",
    "order": 3,
    "tier": "extra",
    "ingest": [
      {
        "label": "ツール配信の RTMP URL",
        "url": null,
        "helpUrl": "https://twitcasting.tv/mybroadcastertool.php"
      }
    ],
    "keyHelpUrl": "https://twitcasting.tv/helpcenter.php?pid=HELP_OBS_INDEX",
    "tosUrl": null,
    "login": {
      "type": "cookie",
      "needed": "optional",
      "for": [
        "題名"
      ]
    },
    "apiHosts": [
      "apiv2.twitcasting.tv",
      "twitcasting.tv"
    ]
  },
  "coreApi": 2
}
